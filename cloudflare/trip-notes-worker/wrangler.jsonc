{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trip-field-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://tkshmrkm.github.io,http://localhost:5511,http://127.0.0.1:5511"
  },
  "secrets": {
    "required": ["SYNC_TOKEN"]
  },
  "kv_namespaces": [
    {
      "binding": "TRIP_NOTES",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
